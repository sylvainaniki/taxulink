# Copy to .env; generate a unique password before seeding (min 16 characters).
DEMO_MODE=true
DEMO_PASSWORD=
PORT=4000
WEB_ORIGIN=http://localhost:3000
# Empty = local PGlite demonstration in .data/demo. For PostgreSQL:
DATABASE_URL=
# DATABASE_URL=postgresql://postgres:local-only@localhost:5432/taxilink
REAL_SENSITIVE_DOCUMENTS_ENABLED=false
# Docker Compose only (URL-safe password without @/: delimiters)
DB_PASSWORD=
