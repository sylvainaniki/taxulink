# Copy to .env; generate a unique password before seeding (min 16 characters).
DEMO_MODE=true
DEMO_PASSWORD=
PORT=4000
WEB_ORIGIN=http://localhost:3000
# Empty = local PGlite demonstration in .data/demo. For PostgreSQL:
DATABASE_URL=
# DATABASE_URL=postgresql://postgres:local-only@localhost:5432/taxilink
REAL_SENSITIVE_DOCUMENTS_ENABLED=false
# Docker Compose only (URL-safe password without @/: delimiters)
DB_PASSWORD=
# Required with network PostgreSQL. Runtime never uses migration credentials.
AUTH_DATABASE_URL=
MIGRATION_DATABASE_URL=
# URL-safe, 32–128 characters each; used by scripts/provision.ts and Compose.
API_DB_PASSWORD=
AUTH_DB_PASSWORD=
# Optional encrypted backup CLI, at least 32 characters. Keep separately.
BACKUP_PASSPHRASE=

# 64 hex characters for encrypting MFA seeds; preserve separately from backups.
MFA_ENCRYPTION_KEY=

# Optional account verification/recovery mail. TLS is mandatory except the local demo mailbox.
MAIL_ENCRYPTION_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
SMTP_ALLOW_INSECURE=false
REQUIRE_VERIFIED_EMAIL=false

# Optional routing provider (OSRM table API); no live traffic.
ROUTING_BASE_URL=
ROUTING_SAFETY_FACTOR=1.25
ROUTING_ALLOW_LOCAL=false
# External notifications remain opt-in. Expo project configuration is required.
PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=
# IGN address/public-place search. Only the dedicated submitted query is sent.
GEOCODING_ENABLED=true
