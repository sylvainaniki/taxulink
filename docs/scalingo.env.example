# Target pilot only. Do not apply to the Render/Neon demonstration.
# These switches do not certify the infrastructure. Contract and deployment review come first.
DEMO_MODE=false
OPERATIONAL_PILOT_ENABLED=true
PUBLIC_REGISTRATION_ENABLED=false
REAL_SENSITIVE_DOCUMENTS_ENABLED=false
DEMO_DOCUMENTS_ENABLED=false
COOKIE_SECURE=true
REQUIRE_VERIFIED_EMAIL=true
API_ORIGIN=http://127.0.0.1:4000
NEXT_TELEMETRY_DISABLED=1
WEB_ORIGIN=
# Restricted business and identity connections, never SCALINGO_POSTGRESQL_URL's owner credentials.
DATABASE_URL=
AUTH_DATABASE_URL=
MFA_ENCRYPTION_KEY=
MAIL_ENCRYPTION_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
SMTP_ALLOW_INSECURE=false
ROUTING_ENABLED=true
GEOCODING_ENABLED=true
PUSH_ENABLED=false
